# Use the same Supabase project and publishable key as the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Postgres connection used by Drizzle and the backend.
DATABASE_URL=postgresql://username:password@hostname:5432/database

# Allowed frontend origin (no path or trailing slash).
FRONTEND_URL=http://localhost:5173

# Cloudflare R2 S3 API endpoint for the account containing your bucket.
# Copy the endpoint for that bucket's jurisdiction from Cloudflare.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
# Public bucket/custom-domain URL used to construct document URLs.
R2_PUBLIC_URL=https://files.example.com

# AI provider credentials (backend only).
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional; defaults to openai/gpt-oss-20b when omitted.
GROQ_MODEL=openai/gpt-oss-20b
